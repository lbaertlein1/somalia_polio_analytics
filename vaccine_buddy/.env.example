# Copy to .env (git-ignored) and fill in.

# Health area adjuster database (read-only use). Same values as the
# adjuster's own .env (DB_* there works here too).
ADJ_DB_HOST=
ADJ_DB_PORT=5432
ADJ_DB_NAME=somalia_health_areas_v2
ADJ_DB_USER=shiny_app
ADJ_DB_PASSWORD=
ADJ_DB_SSL=require

# This app's database (create once with scripts/create_db.R)
VB_DB_HOST=
VB_DB_PORT=5432
VB_DB_NAME=vaccine_buddy
VB_DB_USER=shiny_app
VB_DB_PASSWORD=
VB_DB_SSL=require
# Only needed to run scripts/create_db.R
POSTGRES_PASSWORD=
# Optional: create_db.R seeds an 'admin' login for this app with this password
ADMIN_PASSWORD=

# ODK Central (Vaccine Buddy form)
ODK_URL=https://emro.nafundi.com
ODK_PID=32
ODK_FID=vaccine_buddy_events_aug2025_nopv2_snid
ODK_USERNAME=
ODK_PASSWORD=
ODK_TZ=Africa/Mogadishu

# WorldPop under-5, 100m -- copy from
# health_area_adjuster/modular_health_area_app/data/
WORLDPOP_FILE=data/som_u5_population_2026_100m.tif

# Public address of this app; supervisor links are APP_PUBLIC_URL?t=<token>
APP_PUBLIC_URL=https://<account>.shinyapps.io/vaccine_buddy/
